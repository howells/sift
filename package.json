{
  "name": "@howells/sift",
  "version": "0.3.0",
  "description": "Sift through your email. Surface what matters.",
  "keywords": [
    "ai",
    "cli",
    "email",
    "gmail",
    "inbox",
    "mcp",
    "productivity",
    "tui"
  ],
  "homepage": "https://github.com/howells/sift#readme",
  "bugs": {
    "url": "https://github.com/howells/sift/issues"
  },
  "license": "MIT",
  "author": "Daniel Howells",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/howells/sift.git"
  },
  "bin": {
    "sift": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx",
    "mcp": "node dist/index.js mcp",
    "mcp:dev": "tsx src/index.tsx mcp",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "howells-check src package.json pnpm-workspace.yaml tsconfig.json oxlint.config.ts oxfmt.config.ts",
    "lint:fix": "howells-fix src package.json pnpm-workspace.yaml tsconfig.json oxlint.config.ts oxfmt.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "@howells/ai": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.0",
    "react": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@howells/lint": "2.0.0",
    "@howells/typescript-config": "0.1.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "husky": "9.1.7",
    "knip": "^6.13.1",
    "lint-staged": "^17.0.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css}": "howells-fix"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.5.2"
}
